# Copy to .env and fill in. Never commit .env.

# --- LLM (the brain) ---
# openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.4
LLM_MAX_TOOL_ROUNDS=3
LLM_TIMEOUT_S=30

# --- assistant persona ---
ASSISTANT_NAME=Riya
# empty -> it calls you "sir"
USER_NAME=
TIMEZONE=Asia/Kolkata
MEMORY_IN_PROMPT=40
RESTORE_TURNS=6

# --- wake word ("hey riya") ---
# false -> always listening
WAKE_WORD_ENABLED=true
# transcript = listen for the name in speech (any name, no training)
# openwakeword = tiny dedicated model, only for trained names like hey_jarvis
WAKE_WORD_ENGINE=transcript
# spellings the recogniser might produce for her name
WAKE_PHRASES=riya,ria,rhea,reya,riyah,reah
WAKE_WORD_MODEL=hey_jarvis
# raise if it wakes by itself, lower if it misses you
WAKE_WORD_THRESHOLD=0.5
# keeps listening this long after a reply
FOLLOW_UP_WINDOW_S=8
WAKE_ACK=Yes, {address}?
# turn Spotify down while it listens/talks
DUCK_SPOTIFY=true
DUCK_VOLUME=15

# --- speech to text ---
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
STT_BEAM_SIZE=1
STT_VAD_FILTER=false
STT_MIN_AUDIO_MS=300
STT_PROMPT=Hey Riya.

# --- text to speech ---
TTS_ENGINE=kokoro
# Female voices: af_heart (best), af_bella, bf_emma (British), bf_isabella
TTS_VOICE=af_heart
# a = American English, b = British (match the voice prefix: af_ -> a, bf_ -> b)
TTS_LANG_CODE=a
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000

# --- voice activity detection ---
VAD_THRESHOLD=0.5
VAD_SILENCE_THRESHOLD=0.35
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=700
VAD_PRE_SPEECH_PAD_MS=300
VAD_POST_SPEECH_PAD_MS=200
VAD_MAX_UTTERANCE_MS=20000

# --- audio devices ---
SAMPLE_RATE=16000
CHANNELS=1
AUDIO_CHUNK_SIZE=512
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
BARGE_IN=true
BARGE_IN_THRESHOLD=0.85

# --- tools ---
WEATHER_PROVIDER=open_meteo
DEFAULT_LOCATION=Hyderabad
DATABASE_PATH=data/agent.db
CURRENCY_SYMBOL=Rs.
HTTP_TIMEOUT_S=8

# --- web server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

LOG_LEVEL=INFO
